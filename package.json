  "scripts": {
    "test": "node --experimental-strip-types --test links.test.ts locate.test.ts frontmatter.test.ts diagram.test.ts markdown.test.ts quote.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build ."
  },
  "license": "MIT",
  "author": "Kirill Vechkasov (https://github.com/VKirill)",
  "repository": {
    "type": "git",
    "url": "https://github.com/VKirill/bb-plugin-md-editor.git"
  },
  "homepage": "https://github.com/VKirill/bb-plugin-md-editor#readme",
  "bugs": {
    "url": "https://github.com/VKirill/bb-plugin-md-editor/issues"
  }
}
